{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "turn result",
  "type": "object",
  "required": ["ok", "continue_loop", "reply_required", "timings"],
  "properties": {
    "ok": {"type": "boolean"},
    "continue_loop": {"type": "boolean"},
    "reply_required": {"type": "boolean"},
    "reply_intent": {"type": "object"},
    "error": {"type": "object"},
    "timings": {
      "type": "object",
      "required": ["total_ms"],
      "properties": {"total_ms": {"type": "integer", "minimum": 0}}
    }
  }
}
