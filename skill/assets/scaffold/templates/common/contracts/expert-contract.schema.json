{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Industrial expert contract",
  "type": "object",
  "required": ["name", "purpose", "inputs", "outputs", "boundaries", "failureModes"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "schema", "required"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "schema", "validation"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "schema": {"type": "string", "minLength": 1},
          "validation": {"type": "string", "minLength": 1}
        }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "failureModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "userMessage", "recovery"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "userMessage": {"type": "string", "minLength": 1},
          "recovery": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
